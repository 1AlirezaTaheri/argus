# secrets - never commit (covers .env, .env.local, .env.bak-*, .env.*)
.env
.env.*
!.env.example

# secrets - never commit

# python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/

# test artifacts
.pytest_cache/

# virtualenvs
.venv/
venv/

# local backups
bot.py.bak
legacy/

# editor artifacts (nano/vim swap files can hold buffer contents)
*.swp
*.swo
.*.sw[a-p]

# frontend build artefacts (the admin image runs its own npm build)
node_modules/

# A root-level package-lock.json is always an artefact, never a dependency
# graph. npx writes one named for the mount point when the repository is
# bind-mounted with a subdirectory as the working directory, and an empty
# `{"name": "app", "packages": {}}` was committed here before that was noticed.
#
# Anchored to the root on purpose: admin/frontend/package-lock.json and
# mini-app/package-lock.json are real and must stay tracked, since they are what
# `npm ci` uses to pin the build. Ignoring the filename everywhere would
# untrack those and quietly break the reproducibility they exist to provide.
/package-lock.json
admin/frontend/dist/
*.tsbuildinfo
npm-debug.log*

# local environment overrides
.env.local

# Mini App build artefacts (the image builds its own)
mini-app/dist/
mini-app/node_modules/
